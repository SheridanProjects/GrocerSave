FROM node:18-alpine as build
WORKDIR /app
COPY GrocerSaveWeb/package*.json ./
RUN npm install
COPY GrocerSaveWeb/ .
# The build script will automatically use .env files
RUN npm run build

# Use a more robust Nginx setup that can handle environment variables
FROM nginx:alpine
# Install envsubst
RUN apk add --no-cache gettext

# Copy the built app
COPY --from=build /app/build /usr/share/nginx/html

# Copy a template for the Nginx config
COPY GrocerSaveWeb/nginx.conf.template /etc/nginx/templates/default.conf.template

# When the container starts, it will substitute the env var and start nginx
CMD ["/bin/sh", "-c", "envsubst '$REACT_APP_API_URL' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]

EXPOSE 80