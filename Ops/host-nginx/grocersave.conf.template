# GrocerSave — host nginx reverse proxy + TLS (Cloudflare Origin cert on droplet).
# Deploy: see Ops/host-nginx/install-grocersave-droplet.sh
#
# Upstream: systemd unit grocersave-frontend-portforward forwards k8s svc/frontend to 127.0.0.1:8091.
# Cloudflare: A record (proxied) → this droplet; SSL/TLS mode Full (strict); Origin cert PEM/key below.

upstream grocersave_frontend {
    server 127.0.0.1:8091;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name @DOMAIN@;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @DOMAIN@;

    ssl_certificate /etc/ssl/cloudflare/grocersave-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/grocersave-origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://grocersave_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
