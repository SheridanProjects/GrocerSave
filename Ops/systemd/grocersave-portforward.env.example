# Copy to /etc/default/grocersave-portforward and adjust paths if your repo lives elsewhere.
#   sudo cp Ops/systemd/grocersave-portforward.env.example /etc/default/grocersave-portforward
#   sudo chmod 644 /etc/default/grocersave-portforward
#   configure real path below
KUBECONFIG=/path/to/GrocerSave/Ops/.kubeconfig-localstack 
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1